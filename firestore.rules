rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own profile
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      // Admins can read all users
      allow read: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Products are publicly readable
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Categories are publicly readable
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Carts are private to the user
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders: users can read their own, admins can read/write all
    match /orders/{orderId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || request.auth.token.role == 'admin');
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Reviews: public read, authenticated create, own delete
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Coupons: admin only
    match /coupons/{couponId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Blog posts: public read, admin write
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Settings: admin only
    match /settings/{settingId} {
      allow read, write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Audit logs: admin read only
    match /audit_logs/{logId} {
      allow read: if request.auth != null && request.auth.token.role == 'admin';
      allow create: if request.auth != null;
    }
  }
}
